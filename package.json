{
  "name": "ieee-nub-git-lab",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:fixtures": "playwright test --config playwright.fixture.config.ts",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "format": "prettier --write src tests scripts *.ts *.json .github README.md docs"
  },
  "dependencies": {
    "@codemirror/theme-one-dark": "6.1.3",
    "@supabase/supabase-js": "2.95.3",
    "@tailwindcss/vite": "4.1.18",
    "@uiw/react-codemirror": "4.25.4",
    "buffer": "6.0.3",
    "idb": "8.0.3",
    "isomorphic-git": "1.37.4",
    "lucide-react": "0.563.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-router-dom": "7.18.4",
    "tailwindcss": "4.1.18"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.11",
    "@playwright/test": "1.58.2",
    "@types/node": "24.10.9",
    "@types/react": "19.2.13",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.1.4",
    "eslint": "10.13.0",
    "fake-indexeddb": "6.2.5",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.0",
    "vite": "7.3.7",
    "vitest": "4.1.12"
  }
}
