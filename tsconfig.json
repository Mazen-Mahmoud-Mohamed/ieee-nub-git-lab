{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "types": [
      "vite/client",
      "node"
    ]
  },
  "include": [
    "src",
    "tests/unit",
    "tests/integration",
    "tests/browser-fixtures",
    "vite.config.ts",
    "playwright.config.ts",
    "playwright.fixture.config.ts",
    "tests/mobile",
    "playwright.mobile.config.ts",
    "playwright.mobile-connected.config.ts",
    "tests/production",
    "playwright.production.config.ts"
  ]
}
